# Copy to .env.local (git-ignored) and fill in from
# Supabase dashboard > Project Settings > API Keys.
#
# EXPO_PUBLIC_* values are compiled into the app, so anyone can read them. Only
# ever use the publishable key here, never a secret or service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Crash reporting (F-07.1). Leave empty to turn Sentry off (decision D-4). The DSN is
# public by design. SENTRY_ORG and SENTRY_PROJECT turn on the source-map upload, which also
# needs SENTRY_AUTH_TOKEN: set that only as a secret in EAS, never here.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Product analytics (F-07.2). Leave empty to turn PostHog off (decision D-4). The project
# key is public by design. The host defaults to PostHog's US region.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
